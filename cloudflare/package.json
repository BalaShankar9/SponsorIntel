{
  "name": "sponsorintel-cloudflare",
  "version": "2.33.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "node scripts/verify-marketing-media.mjs && tsc -p tsconfig.json && vite build && node scripts/prerender.mjs && node scripts/verify-browser-budget.mjs",
    "preview": "wrangler dev --port 8788 --ip 127.0.0.1 --local-upstream 127.0.0.1:8788",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "types": "wrangler types"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "docx": "9.8.1",
    "fast-xml-parser": "5.11.2",
    "jspdf": "4.2.1",
    "lucide-react": "0.468.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.7.2",
    "vite": "6.4.3",
    "wrangler": "4.147.0"
  }
}
