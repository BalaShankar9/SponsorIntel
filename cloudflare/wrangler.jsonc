{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sponsorintel",
  "main": "worker/index.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "sponsorintel.london", "custom_domain": true },
    { "pattern": "www.sponsorintel.london", "custom_domain": true },
  ],
  "account_id": "b7d80aea8a0938fe6d92342fa1ac7ea6",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "send_email": [{"name":"EMAIL","allowed_sender_addresses":["accounts@sponsorintel.london"]}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sponsorintel-db",
      "database_id": "f51fb6a9-1278-4643-a49f-30c2e52c6313",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["15 7 * * *", "30 */6 * * *", "*/15 * * * *", "45 * * * *"] },
  "workflows": [
    { "name": "sponsorintel-sources", "binding": "SOURCE_WORKFLOW", "class_name": "SourceWorkflow" },
    { "name": "sponsorintel-research", "binding": "RESEARCH_WORKFLOW", "class_name": "ResearchWorkflow" },
    { "name": "sponsorintel-business", "binding": "BUSINESS_WORKFLOW", "class_name": "BusinessWorkflow" },
    { "name": "sponsorintel-marketing", "binding": "MARKETING_WORKFLOW", "class_name": "MarketingWorkflow" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "vars": {
    "APP_VERSION": "2.17.0",
    "APP_ORIGIN": "https://sponsorintel.london",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "AI_DAILY_LIMIT": "40",
    "AI_REVIEW_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "CHAT_MODEL": "@cf/zai-org/glm-4.7-flash",
    "EMAIL_VERIFICATION_ENABLED": "true",
  },
}
